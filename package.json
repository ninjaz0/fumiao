{
  "name": "fumiao-advanced",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx apps/api/src/main.ts",
    "dev:web": "node --import tsx scripts/dev-studio.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=66 apps packages plugins scripts tests",
    "test": "tsx --test --test-concurrency=4 tests/advanced/*.test.ts",
    "build": "pnpm typecheck && next build apps/web",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "start:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web -p 3000",
    "import:legacy": "node --env-file-if-exists=.env --import tsx scripts/import-legacy.ts",
    "format": "prettier --write 'apps/**/src/**/*.ts' 'apps/web/app/**/*.{ts,tsx,css}' 'packages/**/*.ts' 'plugins/*/src/*.ts' 'scripts/*.ts' 'tests/advanced/*.ts'",
    "test:web": "tsx scripts/smoke-web.ts",
    "dev:web:advanced": "STUDIO_MODE=advanced node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web -p 3000",
    "preview:original": ".runtime-advanced/original/.venv/bin/python scripts/preview-original.py",
    "start:studio": "node --import tsx scripts/dev-studio.ts --production",
    "test:studio": "tsx scripts/smoke-studio.ts",
    "test:studio:nest": "tsx scripts/smoke-studio-nest.ts",
    "test:studio:replicas": "tsx scripts/smoke-studio-nest.ts --replicas",
    "test:studio:remote-provider": "tsx scripts/smoke-studio-nest.ts --remote-provider",
    "test:studio:https": "tsx scripts/smoke-studio-nest.ts --https",
    "test:studio:upgrade": "tsx scripts/smoke-studio-nest.ts --upgrade",
    "test:studio:restore": "tsx scripts/smoke-studio-nest.ts --restore",
    "test:studio-react": "tsx scripts/smoke-studio.ts --studio-react",
    "test:studio-settings": "tsx scripts/verify-studio-settings.ts",
    "test:studio-admin-settings": "tsx scripts/verify-studio-admin-settings.ts",
    "test:studio-member-lifecycle": "tsx scripts/verify-studio-member-lifecycle.ts",
    "test:studio-gpu-settings": "tsx scripts/verify-studio-gpu-settings.ts",
    "test:studio-billing-settings": "tsx scripts/verify-studio-billing-settings.ts",
    "test:studio-services": "tsx scripts/verify-studio-services.ts",
    "test:studio-chat": "tsx scripts/verify-studio-chat.ts",
    "test:studio-composer-nest": "tsx scripts/verify-studio-chat.ts --composer",
    "test:home": "tsx scripts/smoke-studio.ts --visual",
    "test:auth": "tsx scripts/smoke-studio.ts --auth",
    "test:canvas-list": "tsx scripts/smoke-studio.ts --canvas-list",
    "test:recharge": "tsx scripts/smoke-recharge.ts",
    "test:identity": "tsx scripts/smoke-identity.ts",
    "test:media": "tsx scripts/smoke-media.ts",
    "test:generation": "tsx scripts/smoke-generation.ts",
    "test:estimate": "tsx scripts/smoke-generation.ts --estimate",
    "test:state-import": "tsx scripts/smoke-state-import.ts",
    "test:state": "tsx scripts/smoke-state-import.ts --full-state",
    "test:nodes": "tsx --test tests/advanced/original-nodes-http.test.ts",
    "test:downloads": "tsx scripts/smoke-downloads.ts",
    "test:provider-media": "tsx scripts/smoke-provider-media.ts",
    "test:muse-lifecycle": "tsx scripts/smoke-muse-lifecycle.ts",
    "test:flow-lifecycle": "tsx scripts/smoke-flow-lifecycle.ts",
    "test:images-lifecycle": "tsx scripts/smoke-images-lifecycle.ts",
    "test:image-settings": "tsx scripts/smoke-image-settings.ts",
    "test:chat-provider": "tsx scripts/smoke-chat-provider.ts",
    "test:chat-settings": "tsx scripts/smoke-chat-settings.ts",
    "test:chat-storage": "tsx scripts/smoke-chat-storage.ts",
    "test:chat-runtime": "tsx scripts/smoke-chat-runtime.ts",
    "test:chat-http": "tsx scripts/smoke-chat-http.ts",
    "test:chat-import": "tsx scripts/smoke-chat-import.ts",
    "test:canvas-draft": "tsx scripts/smoke-canvas-draft.ts",
    "test:canvas-validation": "tsx scripts/smoke-canvas-validation.ts",
    "test:canvas-storage": "tsx scripts/smoke-canvas-storage.ts",
    "test:canvas-rest": "tsx scripts/smoke-canvas-rest.ts",
    "test:canvas-import": "tsx scripts/smoke-canvas-import.ts",
    "test:canvas-runs": "tsx scripts/smoke-canvas-runs.ts",
    "test:images": "tsx scripts/smoke-images.ts",
    "test:references": "tsx scripts/smoke-references.ts",
    "test:native": "tsx scripts/smoke-native.ts",
    "test:timing": "tsx scripts/smoke-timing.ts",
    "test:queue": "tsx scripts/smoke-queue.ts",
    "test:provider-clock": "tsx scripts/smoke-provider-clock.ts",
    "images:prepare": "node scripts/build-image-codecs.mjs",
    "test:chat-applications": "tsx scripts/smoke-chat-applications.ts",
    "test:canvas-editor-nest": "tsx scripts/verify-canvas-editor-nest.ts",
    "test:canvas-editor": "tsx scripts/verify-canvas-editor.ts",
    "test:canvas-portable-references": "tsx scripts/verify-canvas-editor-nest.ts --portable-references"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@phenomen/libavif-wasm": "1.4.203",
    "@xyflow/react": "^12.9.3",
    "ajv": "^8.17.1",
    "bullmq": "^5.0.0",
    "express": "^5.2.1",
    "gifuct-js": "2.1.2",
    "lucide-react": "0.577.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxlint": "1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  }
}
