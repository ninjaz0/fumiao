{
  "name": "fumiao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx apps/api/src/main.ts",
    "dev:web": "node --import tsx scripts/dev-studio.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "next typegen apps/web && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/advanced/*.test.ts",
    "build": "pnpm typecheck && next build apps/web",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "start:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web -p 3000",
    "jobs:reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcile-job.ts",
    "import:legacy": "node --env-file-if-exists=.env --import tsx scripts/import-legacy.ts",
    "format": "prettier --write 'apps/**/src/**/*.ts' 'apps/web/app/**/*.{ts,tsx,css}' 'packages/**/*.ts' 'plugins/*/src/*.ts' 'scripts/*.ts' 'tests/**/*.ts'",
    "start:studio": "node --import tsx scripts/dev-studio.ts --production",
    "test:studio:nest": "tsx tests/integration/smoke-studio-nest.ts",
    "test:studio:replicas": "tsx tests/integration/smoke-studio-nest.ts --replicas",
    "test:studio:remote-provider": "tsx tests/integration/smoke-studio-nest.ts --remote-provider",
    "test:studio:https": "tsx tests/integration/smoke-studio-nest.ts --https",
    "test:studio:restore": "tsx tests/integration/smoke-studio-nest.ts --restore",
    "images:prepare": "node scripts/build-image-codecs.mjs",
    "test:studio": "tsx tests/integration/smoke-studio-nest.ts --routes && tsx --test tests/integration/studio-bootstrap-retry.test.ts && tsx --test tests/integration/canvas-replace-cancel-browser.ts && tsx tests/integration/composition-poll-browser.ts && tsx tests/integration/asset-action-pending-browser.ts && tsx tests/integration/reference-picker-browser.ts && tsx tests/integration/asset-pack-upload-keyboard-browser.ts && tsx tests/integration/canvas-delete-browser.ts && tsx tests/integration/asset-pack-chooser-cancel-browser.ts && tsx --test tests/integration/canvas-search-browser.ts",
    "test:studio:bootstrap": "pnpm build && tsx --test tests/integration/studio-bootstrap-retry.test.ts",
    "plugins:pack": "node scripts/build-studio-packages.mjs",
    "plugin:dev": "pnpm --silent build:sdk && node packages/plugin-sdk/dist/lib/cli.js dev",
    "plugin:test": "pnpm --silent build:sdk && node packages/plugin-sdk/dist/lib/cli.js test",
    "create:plugin": "pnpm --silent build:sdk && node packages/plugin-sdk/dist/lib/cli.js create",
    "test:plugin-authors": "pnpm build:sdk && node --import tsx --test tests/integration/plugin-authors.test.ts",
    "build:sdk": "node scripts/build-author-sdk.mjs",
    "plugin:keygen": "tsx packages/plugin-sdk/src/cli.ts keygen",
    "plugin:sign": "tsx packages/plugin-sdk/src/cli.ts sign",
    "plugin:verify": "tsx packages/plugin-sdk/src/cli.ts verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@fumiao/image-import": "workspace:*",
    "@fumiao/original-api": "workspace:*",
    "@fumiao/platform": "workspace:*",
    "@fumiao/plugin-chat": "workspace:*",
    "@fumiao/plugin-flow": "workspace:*",
    "@fumiao/plugin-gpu": "workspace:*",
    "@fumiao/plugin-images": "workspace:*",
    "@fumiao/plugin-muse": "workspace:*",
    "@fumiao/plugin-remote": "workspace:*",
    "@fumiao/plugin-sdk": "workspace:*",
    "@fumiao/web-compat": "workspace:*",
    "ajv": "catalog:",
    "bullmq": "catalog:",
    "express": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@playwright/test": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
