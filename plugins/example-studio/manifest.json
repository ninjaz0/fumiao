{
  "id": "local-studio-demo",
  "version": "1.0.0",
  "contractVersion": 1,
  "label": "本地工作台示例",
  "mode": "request",
  "originalSubmission": {
    "version": 2
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "minLength": 1,
        "writeOnly": true
      }
    }
  },
  "models": [
    {
      "id": "local-demo-image",
      "kind": "image",
      "label": "本地示例图片",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ratio", "resolution", "image_quality"],
        "properties": {
          "ratio": {
            "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
          },
          "resolution": {
            "enum": ["1K", "2K"]
          },
          "image_quality": {
            "enum": ["low", "medium", "high"]
          }
        },
        "x-references": {
          "max": 2,
          "types": ["image"]
        }
      },
      "studio": {
        "order": 1000,
        "priceOrder": 1000,
        "descriptor": {
          "kind": "image",
          "label": "本地示例图片"
        },
        "prices": [
          {
            "tier": "1K|low",
            "label": "1K · 草稿",
            "amount": 5,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "1K"
                },
                "image_quality": {
                  "const": "low"
                }
              }
            }
          },
          {
            "tier": "1K|medium",
            "label": "1K · 标准",
            "amount": 7,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "1K"
                },
                "image_quality": {
                  "const": "medium"
                }
              }
            }
          },
          {
            "tier": "1K|high",
            "label": "1K · 高清",
            "amount": 9,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "1K"
                },
                "image_quality": {
                  "const": "high"
                }
              }
            }
          },
          {
            "tier": "2K|low",
            "label": "2K · 草稿",
            "amount": 10,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "2K"
                },
                "image_quality": {
                  "const": "low"
                }
              }
            }
          },
          {
            "tier": "2K|medium",
            "label": "2K · 标准",
            "amount": 12,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "2K"
                },
                "image_quality": {
                  "const": "medium"
                }
              }
            }
          },
          {
            "tier": "2K|high",
            "label": "2K · 高清",
            "amount": 14,
            "match": {
              "type": "object",
              "required": ["resolution", "image_quality"],
              "properties": {
                "resolution": {
                  "const": "2K"
                },
                "image_quality": {
                  "const": "high"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
