# Set DATABASE_URL and REDIS_URL for a local (non-Compose) Studio. Compose
# supplies internal URLs and uses POSTGRES_PASSWORD for its PostgreSQL instance.
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=
PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MEDIA_DIRECTORY=.runtime-advanced/objects
# For an existing Pure workspace, match --source used by export-legacy.py.
# Studio refuses to start until this source is imported in the selected database.
# STUDIO_LEGACY_SOURCE=
# S3_BUCKET enables object storage. Empty uses the shared media volume.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WORKER_CONCURRENCY=8
IMAGE_CONCURRENCY=1
# Optional explicit global byte quota; stored in PostgreSQL by db:migrate/API startup.
# Default on a new database: 20000000000. Leave unset to retain the stored value.
# FUMIAO_QUOTA=20000000000
CREDITS_PER_YUAN=10
