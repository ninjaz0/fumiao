{
  "manifest_version": 3,
  "name": "fmWorker 连接助手",
  "version": "0.3.3",
  "description": "将当前 Chrome 用户的 Flow 连接到本机 fmWorker。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
