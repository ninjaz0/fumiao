  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "从实际 Button 变体提取；状态逻辑仍由 React 负责。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">开始贡献</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 13px;border-radius:8px;border:1px solid transparent;font-weight:560;cursor:pointer;transition:background .12s,border-color .12s,color .12s;font:13px/1.5 var(--font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--accent,#2563eb);color:var(--on-accent,#fff);}.ds-btn-primary:hover:not(:disabled){background:var(--accent-hover,#1d4ed8);}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--surface,#fff),0 0 0 4px var(--accent,#2563eb);}.ds-btn-primary:disabled{opacity:.5;cursor:default}.ds-btn-primary[aria-busy]:disabled{opacity:.75}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "从实际 Button 变体提取；状态逻辑仍由 React 负责。",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">暂停</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 13px;border-radius:8px;border:1px solid transparent;font-weight:560;cursor:pointer;transition:background .12s,border-color .12s,color .12s;font:13px/1.5 var(--font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--surface,#fff);border-color:var(--border,#d9e0ea);color:var(--text,#172033);}.ds-btn-secondary:hover:not(:disabled){background:var(--hover,#eef2f7);}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--surface,#fff),0 0 0 4px var(--accent,#2563eb);}.ds-btn-secondary:disabled{opacity:.5;cursor:default}.ds-btn-secondary[aria-busy]:disabled{opacity:.75}"
    },
    {
      "name": "文字按钮",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "从实际 Button 变体提取；状态逻辑仍由 React 负责。",
