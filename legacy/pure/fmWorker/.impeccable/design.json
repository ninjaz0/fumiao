      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 13px;border-radius:8px;border:1px solid transparent;font-weight:560;cursor:pointer;transition:background .12s,border-color .12s,color .12s;font:13px/1.5 var(--font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--error,#cc3434);color:var(--on-danger,#fff);}.ds-btn-danger:hover:not(:disabled){filter:brightness(.92);}.ds-btn-danger:focus-visible{outline:none;box-shadow:0 0 0 2px var(--surface,#fff),0 0 0 4px var(--accent,#2563eb);}.ds-btn-danger:disabled{opacity:.5;cursor:default}.ds-btn-danger[aria-busy]:disabled{opacity:.75}"
