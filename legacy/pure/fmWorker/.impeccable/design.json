      "css": ".ds-label{display:flex;flex-direction:column;gap:5px;color:var(--text-2,#5a6577);font:12px/1.5 var(--font,sans-serif)}.ds-input{height:32px;padding:0 10px;border:1px solid var(--border,#d9e0ea);border-radius:6px;background:var(--surface-2,#f8fafc);color:var(--text,#172033);min-width:0;font:13px/1.5 var(--font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);}.ds-input:focus-visible{outline:none;border-color:var(--accent,#2563eb);box-shadow:0 0 0 3px var(--accent-soft,rgba(37,99,235,.10))}"
