      "kind": "chip",
      "refersTo": "status-ready",
      "description": "只读状态；色点始终与状态文字配对。",
      "html": "<span class=\"ds-pill\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>可接单</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;background:var(--ok-soft,rgba(19,138,90,.11));color:var(--ok,#08764c);font:560 12px/1.5 var(--font,sans-serif);white-space:nowrap}.ds-dot{width:7px;height:7px;border-radius:50%;background:var(--ok,#08764c)}"
    },
