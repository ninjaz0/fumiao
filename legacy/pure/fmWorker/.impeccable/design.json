      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 13px;border-radius:8px;border:1px solid transparent;font-weight:560;cursor:pointer;transition:background .12s,border-color .12s,color .12s;font:13px/1.5 var(--font,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:transparent;color:var(--accent,#2563eb);}.ds-btn-ghost:hover:not(:disabled){background:var(--accent-soft,rgba(37,99,235,.10));}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 2px var(--surface,#fff),0 0 0 4px var(--accent,#2563eb);}.ds-btn-ghost:disabled{opacity:.5;cursor:default}.ds-btn-ghost[aria-busy]:disabled{opacity:.75}"
    },
