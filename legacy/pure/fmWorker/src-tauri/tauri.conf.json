{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fmWorker",
  "version": "0.4.0",
  "identifier": "com.nvmes.fmworker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fmWorker",
        "width": 1040,
        "height": 790,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/fmworker-bridge"
    ],
    "resources": {
      "../NOTICE": "NOTICE",
      "../resources/LICENSE-Flow2API.txt": "licenses/Flow2API.txt"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
